<Window x:Class="AgOpenGPS.WpfApp.Notifications.TimedMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgOpenGPS"
        Height="180"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True">
    <Border CornerRadius="12"
            Background="#FDECEA"
            BorderBrush="#F5C6CB"
            BorderThickness="1.5"
            Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#721C24"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="MessageTextBlock"
                       FontSize="16"
                       Foreground="#721C24"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
